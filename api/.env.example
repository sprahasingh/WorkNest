NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/worknest?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace_with_a_random_32plus_character_string
ACCESS_TOKEN_TTL=15m
CLIENT_ORIGIN=http://localhost:5173
BCRYPT_COST=12
# Brevo transactional email (recommended for hosted deployments)
# BREVO_API_KEY=your-brevo-api-key
# BREVO_FROM=verified-sender@example.com
# Or configure SMTP instead
# SMTP_URL=smtps://username:app-password@smtp.example.com:465
# SMTP_FROM=no-reply@example.com
# Optional comma-separated addresses that skip signup verification. Only use addresses you control.
# EMAIL_VERIFICATION_BYPASS_EMAILS=you@example.com# Cloudinary, for file and image attachments in Messages. Files are uploaded as
# private, so no upload preset is needed. Leave all three out and attachments
# are switched off.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
