NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/worknest?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace_with_a_random_32plus_character_string
ACCESS_TOKEN_TTL=15m
CLIENT_ORIGIN=http://localhost:5173
BCRYPT_COST=12
# Brevo transactional email (recommended for hosted deployments)
# BREVO_API_KEY=your-brevo-api-key
# BREVO_FROM=verified-sender@example.com
# Or configure SMTP instead
# SMTP_URL=smtps://username:app-password@smtp.example.com:465
# SMTP_FROM=no-reply@example.com
# Where the in-app "Send feedback" form is emailed. Leave it out and the app shows a plain email link instead.
# FEEDBACK_TO_EMAIL=you@example.com
# How many proxies sit in front of the API: 1 behind Render alone, 2 if the web
# app reaches the API through Vercel's /api rewrite. A wrong number makes every
# visitor look like the same address to the rate limits.
# TRUST_PROXY_HOPS=1
# Upgrades without payments (no Razorpay keys). On in development, off in
# production unless you set this to true.
# ALLOW_SIMULATED_UPGRADES=false
# Optional comma-separated addresses that skip signup email verification and the password rules, for shared demo logins. Only use addresses you control.
# EMAIL_VERIFICATION_BYPASS_EMAILS=you@example.com
# Razorpay, for paid plan upgrades. Use TEST keys (rzp_test_...) so no real money moves.
# Leave them out and upgrades are simulated and free.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your-key-secret
# Signs the webhook Razorpay calls after a payment (POST /api/billing/webhook).
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Cloudinary, for file and image attachments in Messages. Files are uploaded as
# private, so no upload preset is needed. Leave all three out and attachments
# are switched off.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# Multiplies every rate limit. Only for automated browser tests that sign up
# many times from one address. Leave it at 1 anywhere real people connect.
# RATE_LIMIT_SCALE=1
