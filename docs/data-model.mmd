erDiagram
    ORGANIZATION ||--o{ MEMBERSHIP : "has"
    ORGANIZATION ||--o{ INVITE : "has"
    ORGANIZATION ||--o{ PROJECT : "has"
    ORGANIZATION ||--o{ TASK : "has"
    ORGANIZATION ||--o{ AUDIT_LOG : "has"
    USER ||--o{ MEMBERSHIP : "belongs via"
    USER ||--o{ SESSION : "has"
    PROJECT ||--o{ TASK : "contains"
    ORGANIZATION ||--o{ CONVERSATION : "has"
    CONVERSATION ||--o{ MESSAGE : "contains"
    ORGANIZATION ||--o{ MEETING : "has"
    ORGANIZATION ||--o{ PAYMENT : "has"
    TASK ||--o{ TASK_ACTIVITY : "has"
    PROJECT ||--o{ TASK_ACTIVITY : "has"
    USER ||--o{ NOTIFICATION : "receives"
    ORGANIZATION ||--o{ NOTIFICATION : "scopes"

    ORGANIZATION {
        ObjectId id PK
        string name
        string slug
        string timeZone
        string plan
        number seatLimit
        number seatsUsed
        number projectLimit
        number projectCount
        number adminCount
        number chatRetentionDays
        ObjectId createdBy
    }
    PAYMENT {
        ObjectId id PK
        ObjectId tenantId FK
        ObjectId userId FK
        string fromPlan
        string plan
        number amount
        string razorpayOrderId
        string razorpayPaymentId
        string status
        date paidAt
    }
    TASK_ACTIVITY {
        ObjectId id PK
        ObjectId tenantId FK
        ObjectId projectId FK
        ObjectId taskId FK
        ObjectId authorId FK
        string type
        string content
        ObjectId[] mentionIds
        ObjectId parentId
        boolean notifyAll
    }
    NOTIFICATION {
        ObjectId id PK
        ObjectId tenantId FK
        ObjectId userId FK
        string type
        string message
        string eventKey
        date readAt
        date dismissedAt
    }
    JOB_LOCK {
        string id PK
        date lockedUntil
    }
    USER {
        ObjectId id PK
        string email
        string name
        string passwordHash
        date onboardingSeenAt
    }
    PENDING_REGISTRATION {
        ObjectId id PK
        string email
        string kind
        string tokenHash
        string signupSecretHash
        date lastSentAt
        date expiresAt
    }
    SIGNUP_CLAIM {
        ObjectId id PK
        string secretHash
        ObjectId userId FK
        date expiresAt
    }
    SESSION {
        ObjectId id PK
        ObjectId userId FK
        string familyId
        string tokenHash
        date expiresAt
        date revokedAt
        ObjectId replacedBy
    }
    MEMBERSHIP {
        ObjectId id PK
        ObjectId tenantId FK
        ObjectId userId FK
        string role
    }
    INVITE {
        ObjectId id PK
        ObjectId tenantId FK
        string email
        string role
        string tokenHash
        ObjectId invitedBy FK
        date expiresAt
        string status
    }
    PROJECT {
        ObjectId id PK
        ObjectId tenantId FK
        string name
        string key
        string description
        date archivedAt
        ObjectId createdBy FK
    }
    TASK {
        ObjectId id PK
        ObjectId tenantId FK
        ObjectId projectId FK
        string title
        string description
        string status
        string priority
        ObjectId[] assigneeIds FK
        date dueDate
        boolean dueDateIsDateOnly
        number reminderCycle
        ObjectId createdBy FK
    }
    AUDIT_LOG {
        ObjectId id PK
        ObjectId tenantId FK
        ObjectId actorId FK
        string action
        string entityType
        ObjectId entityId
    }
    CONVERSATION {
        ObjectId id PK
        ObjectId tenantId FK
        string type
        string name
        string directKey
        ObjectId createdBy FK
        array adminIds
        array members
        date lastMessageAt
    }
    MESSAGE {
        ObjectId id PK
        ObjectId tenantId FK
        ObjectId conversationId FK
        ObjectId senderId FK
        string kind
        string text
        ObjectId replyToId FK
        array mentions
        array attachments
        array reactions
        date editedAt
        date deletedAt
        array hiddenBy
    }
    MEETING {
        ObjectId id PK
        ObjectId tenantId FK
        ObjectId organizerId FK
        string title
        string agenda
        string notes
        date startsAt
        date endsAt
        string joinUrl
        string location
        array attendees
        array proposals
        ObjectId seriesId
        number seriesIndex
        number seriesCount
        string recurrence
        ObjectId projectId FK
        ObjectId taskId FK
        date cancelledAt
    }
